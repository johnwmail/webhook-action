# Copy to ~/.config/webhook-action/webhook-action.env and set real values.
# Generate a secret with:  openssl rand -hex 32
# Then copy it to GitHub > Settings > Webhooks > <your webhook> > Secret.
WEBHOOK_SECRET=change-me-to-a-64-char-hex-secret

# Absolute path to the script executed on every valid webhook delivery.
# The systemd user unit references this file from %h/.config/webhook-action/.
WEBHOOK_SCRIPT_PATH=/home/youruser/webhook-action/deploy.sh

# Defaults to 127.0.0.1:9000 when unset.
#LISTEN_ADDR=127.0.0.1:9000